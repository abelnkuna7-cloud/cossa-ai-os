# Public browser configuration only. Never place service-role keys or provider
# secrets in VITE_* variables because Vite includes them in the client bundle.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
GROQ_API_KEY=
VITE_GTM_CONTAINER_ID=GTM-NSZXXGTD
# GROWTH uses a Cossa owner-approved, read-only Google Analytics OAuth connection.
# These must be production server settings only: never prefix them with VITE_ or
# paste them into a browser, source file, or chat.
# GOOGLE_ANALYTICS_OAUTH_CLIENT_ID=
# GOOGLE_ANALYTICS_OAUTH_CLIENT_SECRET=
# GOOGLE_ANALYTICS_TOKEN_ENCRYPTION_KEY=
# GOOGLE_ANALYTICS_OAUTH_REDIRECT_URI=https://growth.cossanexusholdings.co.za/api/growth-analytics/oauth/callback
PUBLIC_SITE_URL=https://growth.cossanexusholdings.co.za
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Cloudflare Worker secrets only — set these in Cloudflare, never here or in
# the browser bundle. See workers/cossa-owner-alerts/README.md.
# ALERT_SHARED_SECRET=
# CALLMEBOT_API_KEY=
# CALLMEBOT_OWNER_PHONE=
# COSSA_ORGANISATION_ID=
# SUPABASE_SERVICE_ROLE_KEY=
