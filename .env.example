# Public browser configuration only. Never place service-role keys or provider
# secrets in VITE_* variables because Vite includes them in the client bundle.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_GTM_CONTAINER_ID=GTM-NSZXXGTD
# GROWTH uses a Cossa owner-approved, read-only Google Analytics OAuth connection.
# These must be production server settings only: never prefix them with VITE_ or
# paste them into a browser, source file, or chat.
# GOOGLE_ANALYTICS_OAUTH_CLIENT_ID=
# GOOGLE_ANALYTICS_OAUTH_CLIENT_SECRET=
# GOOGLE_ANALYTICS_TOKEN_ENCRYPTION_KEY=
# GOOGLE_ANALYTICS_OAUTH_REDIRECT_URI=https://growth.cossanexusholdings.co.za/api/growth-analytics/oauth/callback
PUBLIC_SITE_URL=https://growth.cossanexusholdings.co.za
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Protected server/worker secrets — set these only in the relevant Vercel or
# Cloudflare secret store, never in this file or the browser bundle.
# ALERT_SHARED_SECRET=
# CALLMEBOT_API_KEY=
# CALLMEBOT_OWNER_PHONE=
# COSSA_ORGANISATION_ID=
# SUPABASE_SERVICE_ROLE_KEY=
# AGENT_RUNTIME_WORKER_TOKEN=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# HUNTER_API_KEY=
# FIRECRAWL_API_KEY=
# COMPOSIO_API_KEY=
# E2B_API_KEY=
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# AGENTMAIL_API_KEY= # Keep unset until mail migration and owner approval.
# AGENT_GROQ_MODEL=llama-3.3-70b-versatile
# AGENT_OPENAI_MODEL=
# AGENT_GEMINI_MODEL=gemini-2.5-flash

# Private, keyless Google Analytics reader for the GROWTH platform dashboard.
# These are connection identifiers only (not passwords or keys). Set them only
# in the GROWTH server environment, never in VITE_* browser variables.
# GCP_PROJECT_NUMBER=581324238744
# GCP_SERVICE_ACCOUNT_EMAIL=growth-analytics-reader@cossa-growth-analytics.iam.gserviceaccount.com
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-growth
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# NEXDOCS_GA4_PROPERTY_ID=542468613
